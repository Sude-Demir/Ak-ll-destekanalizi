# Frontend (Next.js) tarafından kullanılır.
# Bu dosyayı .env.local olarak kopyalayın: cp .env.example .env.local
# .env.local dosyası asla commit edilmez (Next.js'in kendi .gitignore'u zaten hariç tutar).

# Backend API adresi. Belirtilmezse http://localhost:8000 varsayılan olarak kullanılır.
NEXT_PUBLIC_API_URL=http://localhost:8000
