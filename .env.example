# Backend (FastAPI) ve scripts/ tarafından kullanılır.
# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi girin: cp .env.example .env
# .env dosyası asla commit edilmez (bkz. .gitignore).

# PostgreSQL bağlantı adresi (SQLAlchemy formatı).
# docker-compose.yml ile gelen varsayılan yerel kurulumla eşleşir:
DATABASE_URL=postgresql+psycopg2://destek_asistani:destek_asistani@localhost:5432/destek_asistani

# Google Gemini API anahtarı. Embedding üretimi (Hafta 2) ve LLM (sınıflandırma +
# taslak üretimi, Hafta 3) entegrasyonu için kullanılacak.
# https://aistudio.google.com/apikey adresinden alınabilir.
GEMINI_API_KEY=
